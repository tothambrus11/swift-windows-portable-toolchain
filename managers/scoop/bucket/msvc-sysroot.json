{
    "version":  "10.0.28000.2957",
    "description":  "MSVC C/C++ runtime + Windows SDK headers and libraries, fetched from Microsoft after license acceptance (for Swift/clang without Visual Studio)",
    "homepage":  "https://github.com/tothambrus11/swift-windows-portable-toolchain",
    "license":  {
                    "identifier":  "Proprietary",
                    "url":  "https://aka.ms/WinSDKLicenseURL"
                },
    "notes":  [
                  "The MSVC C/C++ runtime and the Windows SDK are Microsoft software. msvc-sysroot downloads them from Microsoft",
                  "(Visual Studio channel manifest, nuget.org) on this machine, after you accept their license terms:",
                  "  https://go.microsoft.com/fwlink/?LinkId=2179911 (Visual Studio Build Tools) and https://aka.ms/WinSDKLicenseURL",
                  "Accept interactively, or set SWIFT_PORTABLE_ACCEPT_MSVC_LICENSE=1 before `scoop install`.",
                  "With Visual Studio (VC tools) installed, nothing is downloaded and VS is used (SWIFT_PORTABLE_MSVC=portable overrides)."
              ],
    "url":  "https://raw.githubusercontent.com/tothambrus11/swift-windows-portable-toolchain/exp/managers/managers/common/setup-portable-swift.ps1",
    "hash":  "c2b2246b3bd6ca6fb2b6b9234c3fbcd48d8afca25ce076527058da6ae5fc4f77",
    "installer":  {
                      "script":  [
                                     "$spArch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
                                     "$spPs = (Get-Process -Id $PID).Path",
                                     "$spSys = \"$dir\\winsysroot\"",
                                     "$spMode = if ($env:SWIFT_PORTABLE_MSVC) { $env:SWIFT_PORTABLE_MSVC } else { 'auto' }",
                                     "$spVs = $null",
                                     "$spVswhere = \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\"",
                                     "if ($spMode -eq 'auto' -and (Test-Path $spVswhere)) {",
                                     "    $spComp = if ($spArch -eq 'arm64') { 'Microsoft.VisualStudio.Component.VC.Tools.ARM64' } else { 'Microsoft.VisualStudio.Component.VC.Tools.x86.x64' }",
                                     "    $spVs = & $spVswhere -latest -products * -requires $spComp -property installationPath",
                                     "}",
                                     "if ($spVs) {",
                                     "    New-Item -ItemType Directory -Force $spSys | Out-Null",
                                     "    [System.IO.File]::WriteAllText(\"$spSys\\sysroot.json\", (@{ kind = 'vs'; path = \"$spVs\" } | ConvertTo-Json))",
                                     "    Write-Host \"msvc-sysroot: using the installed Visual Studio at $spVs - nothing is downloaded from Microsoft.\" -ForegroundColor Green",
                                     "    Write-Host 'msvc-sysroot: (set SWIFT_PORTABLE_MSVC=portable and reinstall to use the portable sysroot anyway)'",
                                     "} else {",
                                     "    $spOk = \"$env:SWIFT_PORTABLE_ACCEPT_MSVC_LICENSE\" -match '^(1|true|yes|y)$'",
                                     "    if (-not $spOk) {",
                                     "        Write-Host ''",
                                     "        Write-Host 'msvc-sysroot downloads Microsoft software from Microsoft onto this machine:' -ForegroundColor Yellow",
                                     "        Write-Host '  - MSVC C/C++ runtime headers and libraries (Visual Studio Build Tools license):'",
                                     "        Write-Host '      https://go.microsoft.com/fwlink/?LinkId=2179911'",
                                     "        Write-Host '  - Windows SDK headers and import libraries (Windows SDK license):'",
                                     "        Write-Host '      https://aka.ms/WinSDKLicenseURL'",
                                     "        Write-Host ''",
                                     "        if (-not $env:CI -and [Environment]::UserInteractive -and -not [Console]::IsInputRedirected) {",
                                     "            $spOk = (Read-Host 'Do you accept these license terms? [y/N]') -match '^(y|yes)$'",
                                     "        }",
                                     "    }",
                                     "    if (-not $spOk) {",
                                     "        throw ('msvc-sysroot: the Microsoft license terms were not accepted, nothing was downloaded. ' +",
                                     "            'To accept them non-interactively set SWIFT_PORTABLE_ACCEPT_MSVC_LICENSE=1, then run: scoop install msvc-sysroot')",
                                     "    }",
                                     "    & $spPs -NoProfile -ExecutionPolicy Bypass -File \"$dir\\$fname\" -Part fetch-sysroot -Target $dir -SysrootDir $spSys -Arch $spArch -NugetSdkVersion $version -AcceptLicense",
                                     "    if ($LASTEXITCODE) { throw \"msvc-sysroot: fetching the MSVC runtime / Windows SDK failed (exit $LASTEXITCODE)\" }",
                                     "}"
                                 ]
                  },
    "post_install":  [
                         "$spApps = Split-Path (Split-Path $dir)",
                         "$spSys = \"$spApps\\msvc-sysroot\\current\\winsysroot\"",
                         "$spPs = (Get-Process -Id $PID).Path",
                         "$spKind = (Get-Content -Raw \"$spSys\\sysroot.json\" | ConvertFrom-Json).kind",
                         "foreach ($spApp in 'swift-portable', 'swift-portable-official') {",
                         "    Get-ChildItem \"$spApps\\$spApp\" -Directory -ErrorAction SilentlyContinue |",
                         "        Where-Object { $_.Name -ne 'current' -and (Test-Path \"$($_.FullName)\\Swift\\Toolchains\") } | ForEach-Object {",
                         "            $spPart = if ($spKind -eq 'portable') { 'link' } else { 'env' }",
                         "            Write-Host \"msvc-sysroot: re-configuring $spApp $($_.Name) for the new sysroot ($spKind)\"",
                         "            if ($spKind -ne 'portable') { Remove-Item \"$($_.FullName)\\Swift\\Toolchains\\current\\usr\\bin\\clang*.cfg\" -ErrorAction SilentlyContinue }",
                         "            & $spPs -NoProfile -ExecutionPolicy Bypass -File \"$dir\\$fname\" -Part $spPart -Target $_.FullName -SysrootDir $spSys | Out-Null",
                         "        }",
                         "}"
                     ],
    "checkver":  {
                     "url":  "https://api.nuget.org/v3-flatcontainer/microsoft.windows.sdk.cpp/index.json",
                     "script":  [
                                    "$v = (Invoke-RestMethod 'https://api.nuget.org/v3-flatcontainer/microsoft.windows.sdk.cpp/index.json').versions | Where-Object { $_ -match '^\\d+\\.\\d+\\.\\d+\\.\\d+$' }",
                                    "return @($v)[-1]"
                                ],
                     "regex":  "([\\d.]+)"
                 },
    "autoupdate":  {
                       "url":  "https://raw.githubusercontent.com/tothambrus11/swift-windows-portable-toolchain/exp/managers/managers/common/setup-portable-swift.ps1"
                   }
}
